+        XCTAssertTrue(clicks.isEmpty);XCTAssertTrue(presses.isEmpty)
+        control.handle(.init(.motion,id:"review-changes-1",sequence:1,y:10))
+        XCTAssertEqual(control.focusedCell,.wandReviewChanges)
