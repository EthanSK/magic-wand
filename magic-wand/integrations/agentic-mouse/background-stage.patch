+        let result = withUnsafePointer(to: &address) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { Darwin.connect(fd, $0, socklen_t(MemoryLayout<sockaddr_un>.size)) }
+        }
+        if result != 0 {
+            guard errno == EINPROGRESS || errno == EAGAIN, wait(Int16(POLLOUT)) else { return nil }
+            var error: Int32 = 0
+            var size = socklen_t(MemoryLayout.size(ofValue: error))
+            guard getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size) == 0, error == 0 else { return nil }
+        }
+        var uid: uid_t = 0, gid: gid_t = 0
+        guard getpeereid(fd, &uid, &gid) == 0, uid == getuid() else { return nil }
+        let data = body + Data([10])
+        var offset = 0
+        while offset < data.count {
+            guard wait(Int16(POLLOUT)) else { return nil }
+            let sent = data.withUnsafeBytes { Darwin.send(fd, $0.baseAddress!.advanced(by: offset), data.count - offset, 0) }
+            if sent < 0, errno == EAGAIN || errno == EWOULDBLOCK { continue }
+            guard sent > 0 else { return nil }
+            offset += sent
+        }
+        var reply = Data()
+        var buffer = [UInt8](repeating: 0, count: 512)
+        while reply.count <= 4_096 {
+            guard wait(Int16(POLLIN)) else { return nil }
+            let received = recv(fd, &buffer, buffer.count, 0)
+            if received < 0, errno == EAGAIN || errno == EWOULDBLOCK { continue }
+            guard received > 0 else { return nil }
+            reply.append(contentsOf: buffer.prefix(received))
+            if let newline = reply.firstIndex(of: 10) {
+                guard newline <= 4_096 else { return nil }
+                return (try? JSONSerialization.jsonObject(with: reply.prefix(upTo: newline))) as? [String: Any]
+            }
+        }
+        return nil
+    }
+
+    private func validDirectory() -> Bool {
+        var info = stat()
+        return lstat(directory, &info) == 0 && info.st_uid == getuid()
+            && info.st_mode & S_IFMT == S_IFDIR && info.st_mode & 0o777 == 0o700
+    }
+
+    private func endpoint(at path: String) -> Endpoint? {
+        guard path.hasPrefix(directory + "/") else { return nil }
+        var info = stat()
+        guard lstat(path, &info) == 0, info.st_uid == getuid(),
+              info.st_mode & S_IFMT == S_IFSOCK, info.st_mode & 0o777 == 0o600 else { return nil }
+        return Endpoint(path: path, device: info.st_dev, inode: info.st_ino)
+    }
+}
