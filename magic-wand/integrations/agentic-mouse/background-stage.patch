+import AppKit
+import Foundation
+import ScimitarKit
+
+/// Ethan's held staging button keeps its original review when another app comes forward.
+/// Only physical owner release can finish; focus changes never stage or abandon it.
+@MainActor
+final class VSCodeBackgroundHoldController {
+    typealias Endpoint = VSCodeBackgroundHoldTransport.Endpoint
+    struct Packet: Sendable {
+        let phase: String
+        let direction: String
+        let mode: String
+        var terminal: Bool { ["finish", "cancel", "abandon", "boundary"].contains(phase) }
+    }
+    @MainActor private final class Hold {
+        let id = UUID().uuidString
+        let direction: VSCodeStageHoldCommand.Direction
+        var endpoint: Endpoint?
+        let pressedAt = ProcessInfo.processInfo.systemUptime
+        var discovering = false
+        var sequence = 0
+        var queue: [Packet] = []
+        var inFlight = false
+        var failed = false
+        var ending = false
+        var shortRelease = false
+        var mode = "changes"
+        var lastStepAt: TimeInterval = 0
+        init(_ direction: VSCodeStageHoldCommand.Direction) { self.direction = direction }
+    }
+    private let worker = DispatchQueue(label: "com.ethansk.agentic-mouse.better-git-hold")
+    private let discover: @Sendable () -> Endpoint?
+    private let exchange: @Sendable (Endpoint, [String: Any]) -> [String: Any]?
+    private let allowed: () -> Bool
+    private let canBegin: () -> Bool
+    private var holds: [MouseSource: Hold] = [:]
+    private var pipelines: [MouseSource: [Hold]] = [:]
+    private var owners = Set<MouseSource>()
+    private var timer: Timer?
+    var onFailure: ((MouseSource) -> Void)?
+    var onOwnerReleased: ((MouseSource) -> Void)?
+
+    init(allowed: @escaping () -> Bool,
+         canBegin: @escaping () -> Bool = { NSWorkspace.shared.frontmostApplication?.bundleIdentifier == "com.microsoft.VSCode" },
+         discover: @escaping @Sendable () -> Endpoint? = { VSCodeBackgroundHoldTransport().discover() },
+         exchange: @escaping @Sendable (Endpoint, [String: Any]) -> [String: Any]? = { VSCodeBackgroundHoldTransport().exchange($0, object: $1) }) {
+        self.allowed = allowed; self.canBegin = canBegin; self.discover = discover; self.exchange = exchange
+    }
+
+    func owns(_ source: MouseSource) -> Bool { owners.contains(source) }
+
+    @discardableResult
+    func handle(_ command: VSCodeStageHoldCommand) -> Bool {
+        guard command.source.isPhysicalAdapter else { return false }
+        if command.phase == .begin { return begin(command.source, direction: command.direction) }
+        guard holds[command.source]?.direction == command.direction else { return true }
+        switch command.phase {
+        case .begin: break
+        case .ready: enqueue("ready", source: command.source)
+        case .shortRelease:
+            holds[command.source]?.shortRelease = true
+            enqueue("short-release", source: command.source)
+        case .finish: enqueue("finish", source: command.source)
+        case .cancel: enqueue("cancel", source: command.source)
+        case .ownerRelease: ownerReleased(command.source)
+        }
+        return true
+    }
+
+    @discardableResult
+    func handleMode(_ command: VSCodeModeCommand, source: MouseSource) -> Bool {
+        guard source.isPhysicalAdapter else { return false }
+        switch command {
+        case .beginNextChangeHold: return begin(source, direction: .next)
+        case .beginPreviousChangeHold: return begin(source, direction: .previous)
+        case .stageHoldReady: enqueue("ready", source: source)
+        case .cancelNavigationHold:
+            holds[source]?.shortRelease = true
+            enqueue("short-release", source: source)
+        case .finishNextChangeHold:
+            if holds[source]?.direction == .next { enqueue("finish", source: source) }
+        case .finishPreviousChangeHold:
+            if holds[source]?.direction == .previous { enqueue("finish", source: source) }
+        case .stageHoldClear: break // The explicit physical edge owns the boundary, not decoration cleanup.
+        case .undoLastStageAndAdvance:
+            guard owns(source) else { return false }
+            enqueue("cancel", source: source)
+        default: return false
+        }
+        return true
+    }
+
+    @discardableResult
+    func step(_ direction: String, mode: String, source: MouseSource) -> Bool {
+        enqueue("step", direction: direction, mode: mode, source: source)
+    }
+
+    @discardableResult
+    func mode(_ active: Bool, source: MouseSource) -> Bool {
+        enqueue("mode", mode: active ? "changes" : "files", source: source)
+    }
+
+    func ownerReleased(_ source: MouseSource) {
+        guard owners.remove(source) != nil else { return }
+        if let hold = holds[source], hold.shortRelease && !hold.ending && !hold.failed {
+            enqueue("boundary", source: source)
+        }
+        if let hold = holds[source], hold.failed || (hold.ending && !hold.inFlight && hold.queue.isEmpty) { holds[source] = nil }
+        stopTimerIfIdle()
+        onOwnerReleased?(source)
+    }
+
+    func abandonAll() {
+        for source in Set(holds.keys).union(pipelines.keys) { abandon(source, includingReleased: true) }
+    }
+
+    func abandon(_ source: MouseSource, includingReleased: Bool = false) {
+        guard includingReleased || owns(source) else { return }
+        let current = holds[source]
+        let queued = (pipelines[source] ?? []).filter { includingReleased || $0 === current }
+        pipelines[source]?.removeAll { item in queued.contains(where: { $0 === item }) }
+        holds[source] = nil
+        owners.remove(source)
+        for hold in queued where !hold.failed {
+            guard let endpoint = hold.endpoint else { continue }
+            let sequence = hold.sequence + 1
+            let object: [String: Any] = ["version": 1, "phase": "abandon", "id": hold.id, "seq": sequence,
+                "source": source.rawValue, "direction": hold.direction.rawValue, "mode": hold.mode]
+            worker.async { _ = self.exchange(endpoint, object) }
+        }
+        stopTimerIfIdle()
+        startNext(source)
+    }
+
+    private func begin(_ source: MouseSource, direction: VSCodeStageHoldCommand.Direction) -> Bool {
+        guard allowed(), canBegin() else { return true } // Consume a rejected hold; never fall back to foreground keys.
+        guard !owns(source) else { return true }
+        let hold = Hold(direction)
+        holds[source] = hold; owners.insert(source)
+        hold.queue = [Packet(phase: "begin", direction: direction.rawValue, mode: "changes")]
+        guard (pipelines[source]?.count ?? 0) < 4 else { hold.failed = true; onFailure?(source); return true }
+        pipelines[source, default: []].append(hold)
+        if timer == nil {
+            timer = Timer.scheduledTimer(withTimeInterval: 0.5, repeats: true) { [weak self] _ in
+                MainActor.assumeIsolated { self?.heartbeat() }
+            }
+        }
+        startNext(source)
+        return true
+    }
+
+    private func startNext(_ source: MouseSource) {
+        guard let hold = pipelines[source]?.first, !hold.discovering, hold.endpoint == nil else { return }
+        hold.discovering = true
+        worker.async {
+            let endpoint = self.discover()
+            DispatchQueue.main.async {
+                guard self.pipelines[source]?.first === hold else { return }
+                guard self.allowed(), let endpoint, ProcessInfo.processInfo.systemUptime - hold.pressedAt < 0.5 else {
+                    self.fail(source, hold: hold); return
+                }
+                hold.endpoint = endpoint
+                self.pump(source, hold: hold)
+            }
+        }
+    }
+
+    @discardableResult
+    private func enqueue(_ phase: String, direction: String? = nil, mode: String? = nil, source: MouseSource) -> Bool {
+        guard allowed(), let hold = holds[source], !hold.failed, !hold.ending else { return false }
+        guard hold.queue.count < 64 else { fail(source, hold: hold); return false }
+        if phase == "step" { hold.lastStepAt = ProcessInfo.processInfo.systemUptime }
+        if let mode { hold.mode = mode }
+        let packet = Packet(phase: phase, direction: direction ?? hold.direction.rawValue, mode: hold.mode)
+        hold.queue.append(packet)
+        if packet.terminal { hold.ending = true }
+        pump(source, hold: hold)
+        return true
+    }
+
+    private func pump(_ source: MouseSource, hold: Hold) {
+        guard pipelines[source]?.first === hold, !hold.inFlight, !hold.failed,
+              let endpoint = hold.endpoint, !hold.queue.isEmpty else { return }
+        guard allowed() else { abandon(source); return }
+        let packet = hold.queue.removeFirst()
+        if packet.phase == "step", ProcessInfo.processInfo.systemUptime - hold.lastStepAt > 0.3 {
+            pump(source, hold: hold)
+            return // Preserve Better Git's wheel-idle cutoff before transport delays can make old input look fresh.
+        }
+        hold.sequence += 1
+        let sequence = hold.sequence
+        let object: [String: Any] = ["version": 1, "phase": packet.phase, "id": hold.id, "seq": sequence,
+            "source": source.rawValue, "direction": packet.direction, "mode": packet.mode]
+        hold.inFlight = true
+        worker.async {
+            let maySend = DispatchQueue.main.sync { self.pipelines[source]?.first === hold && self.allowed() }
+            let reply = maySend ? self.exchange(endpoint, object) : nil
+            DispatchQueue.main.async {
+                guard self.pipelines[source]?.first === hold else { return }
+                hold.inFlight = false
+                guard reply?["accepted"] as? Bool == true, reply?["id"] as? String == hold.id,
+                      reply?["seq"] as? Int == sequence else { self.fail(source, hold: hold); return }
+                if packet.terminal {
+                    self.retire(source, hold: hold)
+                } else { self.pump(source, hold: hold) }
+            }
+        }
+    }
+
+    private func heartbeat() {
+        guard allowed() else { abandonAll(); return }
+        for source in owners {
+            guard let hold = holds[source], !hold.failed, !hold.ending,
+                  !hold.queue.contains(where: { $0.phase == "heartbeat" }) else { continue }
+            enqueue("heartbeat", source: source)
+        }
+    }
+
+    private func fail(_ source: MouseSource, hold: Hold) {
+        hold.failed = true; hold.queue.removeAll()
+        retire(source, hold: hold)
+        onFailure?(source) // Keep consuming the old physical hold until its release; never redirect it.
+    }
+
+    private func retire(_ source: MouseSource, hold: Hold) {
+        pipelines[source]?.removeAll { $0 === hold }
+        if holds[source] === hold && !owns(source) { holds[source] = nil }
+        startNext(source)
+    }
+
+    private func stopTimerIfIdle() {
+        if owners.isEmpty { timer?.invalidate(); timer = nil }
+    }
+}
