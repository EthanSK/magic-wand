+import Darwin
+import Foundation
+import XCTest
+@testable import AgenticMouseApp
+
+private final class HoldSocketFixture {
+    let directory = URL(fileURLWithPath: "/tmp", isDirectory: true).appendingPathComponent("bg-hold-" + UUID().uuidString)
+    let process = Process()
+    init(oversized: Bool = false) throws {
+        guard FileManager.default.isExecutableFile(atPath: "/usr/bin/python3") else { throw XCTSkip("Python is unavailable for the local Unix socket fixture") }
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: false, attributes: [.posixPermissions: 0o700])
+        process.executableURL = URL(fileURLWithPath: "/usr/bin/python3")
+        process.arguments = ["-u", "-c", #"""
+import socket,os,json,sys,pathlib
+root=sys.argv[1]
+server=socket.socket(socket.AF_UNIX,socket.SOCK_STREAM)
+server.bind(root+'/vscode-fixture.sock')
+os.chmod(root+'/vscode-fixture.sock',0o600)
+server.listen(8)
+pathlib.Path(root+'/ready').write_text('ready')
+while True:
+ c,_=server.accept()
+ q=json.loads(c.recv(4096).decode())
+ r={'version':1,'extensionVersion':'1.2.136','backgroundHold':True,'canBegin':True} if q['phase']=='probe' else {'accepted':True,'id':q['id'],'seq':q['seq']}
+ if sys.argv[2]=='large':r['padding']='x'*6000
+ c.sendall((json.dumps(r)+'\n').encode())
+ c.close()
+"""#, directory.path, oversized ? "large" : "normal"]
+        process.standardOutput = FileHandle.nullDevice; process.standardError = FileHandle.nullDevice
+        try process.run()
+        let deadline = Date().addingTimeInterval(2)
+        while !FileManager.default.fileExists(atPath: directory.appendingPathComponent("ready").path), process.isRunning, Date() < deadline { usleep(10_000) }
+        guard FileManager.default.fileExists(atPath: directory.appendingPathComponent("ready").path) else {
+            stop(); throw NSError(domain: "HoldSocketFixture", code: 1)
+        }
+        // The native discovery bound counts this file too, but only .sock entries are probed.
+    }
+    func stop() {
+        if process.isRunning { process.terminate(); process.waitUntilExit() }
+        try? FileManager.default.removeItem(at: directory)
+    }
+}
+
+final class VSCodeBackgroundHoldTransportTests: XCTestCase {
+    func testActualUnixProbeAndAdmissionUseTheValidatedEndpoint() throws {
+        let fixture = try HoldSocketFixture(); defer { fixture.stop() }
+        let transport = VSCodeBackgroundHoldTransport(directory: fixture.directory.path)
+        let endpoint = try XCTUnwrap(transport.discover())
+        let id = UUID().uuidString
+        let reply = try XCTUnwrap(transport.exchange(endpoint, object: ["version": 1, "phase": "begin", "id": id,
+            "seq": 1, "source": "corsair", "direction": "next", "mode": "changes"]))
+        XCTAssertEqual(reply["accepted"] as? Bool, true)
+        XCTAssertEqual(reply["id"] as? String, id)
+        XCTAssertEqual(reply["seq"] as? Int, 1)
+    }
+
+    func testSymlinkAndPublicDirectoryAreRejectedWithoutConnecting() throws {
+        let fixture = try HoldSocketFixture(); defer { fixture.stop() }
+        let alias = fixture.directory.appendingPathExtension("alias")
+        try FileManager.default.createSymbolicLink(at: alias, withDestinationURL: fixture.directory)
+        defer { try? FileManager.default.removeItem(at: alias) }
+        XCTAssertNil(VSCodeBackgroundHoldTransport(directory: alias.path).discover())
+        try FileManager.default.setAttributes([.posixPermissions: 0o755], ofItemAtPath: fixture.directory.path)
+        XCTAssertNil(VSCodeBackgroundHoldTransport(directory: fixture.directory.path).discover())
+    }
+
+    func testReplacedSocketCannotReceiveAnExistingGesture() throws {
+        let fixture = try HoldSocketFixture(); defer { fixture.stop() }
+        let transport = VSCodeBackgroundHoldTransport(directory: fixture.directory.path)
+        let endpoint = try XCTUnwrap(transport.discover())
+        try FileManager.default.moveItem(atPath: endpoint.path, toPath: endpoint.path + ".old")
+        _ = FileManager.default.createFile(atPath: endpoint.path, contents: Data(), attributes: [.posixPermissions: 0o600])
+        XCTAssertNil(transport.exchange(endpoint, object: ["version": 1, "phase": "probe"]))
+    }
+
+    func testOversizedReplyFailsClosed() throws {
+        let fixture = try HoldSocketFixture(oversized: true); defer { fixture.stop() }
+        XCTAssertNil(VSCodeBackgroundHoldTransport(directory: fixture.directory.path).discover())
+    }
+}
