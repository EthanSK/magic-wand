+import Darwin
+import Foundation
+
+/// Bounded, same-user transport to Better Git's original VS Code window.
+/// Socket paths are never created here or rediscovered after a hold begins.
+struct VSCodeBackgroundHoldTransport: Sendable {
+    struct Endpoint: Equatable, Sendable {
+        let path: String
+        let device: Int32
+        let inode: UInt64
+    }
+
+    let directory: String
+    init(directory: String = "/tmp/better-git-mouse-\(getuid())") { self.directory = directory }
+
+    func discover() -> Endpoint? {
+        guard validDirectory(), let names = try? FileManager.default.contentsOfDirectory(atPath: directory), names.count <= 64 else { return nil }
+        var available: [Endpoint] = []
+        let deadline = ProcessInfo.processInfo.systemUptime + 0.35
+        for name in names.sorted() where name.hasPrefix("vscode-") && name.hasSuffix(".sock") && !name.contains("/") {
+            guard ProcessInfo.processInfo.systemUptime < deadline else { return nil }
+            let path = directory + "/" + name
+            guard let endpoint = endpoint(at: path),
+                  let reply = exchange(endpoint, object: ["version": 1, "phase": "probe"]),
+                  reply["version"] as? Int == 1,
+                  reply["backgroundHold"] as? Bool == true,
+                  reply["canBegin"] as? Bool == true else { continue }
+            available.append(endpoint)
+            if available.count > 1 { return nil }
+        }
+        return available.first
+    }
+
+    func exchange(_ target: Endpoint, object: [String: Any]) -> [String: Any]? {
+        guard validDirectory(), endpoint(at: target.path) == target,
+              let body = try? JSONSerialization.data(withJSONObject: object), body.count <= 2_048 else { return nil }
+        let fd = socket(AF_UNIX, SOCK_STREAM, 0)
+        guard fd >= 0 else { return nil }
+        defer { close(fd) }
+        var one: Int32 = 1
+        _ = setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &one, socklen_t(MemoryLayout.size(ofValue: one)))
+        _ = fcntl(fd, F_SETFL, O_NONBLOCK)
+        var address = sockaddr_un()
+        address.sun_family = sa_family_t(AF_UNIX)
+        address.sun_len = UInt8(MemoryLayout<sockaddr_un>.size)
+        let bytes = Array(target.path.utf8) + [0]
+        guard bytes.count <= MemoryLayout.size(ofValue: address.sun_path) else { return nil }
