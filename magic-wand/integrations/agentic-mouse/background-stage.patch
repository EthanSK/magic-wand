+import Foundation
+import ScimitarKit
+import XCTest
+@testable import AgenticMouseApp
+
+private final class HoldWire: @unchecked Sendable {
+    typealias Endpoint = VSCodeBackgroundHoldTransport.Endpoint
+    let endpoint = Endpoint(path: "/test/original.sock", device: 1, inode: 1)
+    let lock = NSLock()
+    var packets: [(Endpoint, [String: Any])] = []
+    var discoveries = 0
+    var rejectStep = false
+    var delay: useconds_t = 0
+    func discover() -> Endpoint? { lock.lock(); defer { lock.unlock() }; discoveries += 1; return endpoint }
+    func send(_ endpoint: Endpoint, _ packet: [String: Any]) -> [String: Any]? {
+        lock.lock(); packets.append((endpoint, packet)); let reject = rejectStep && packet["phase"] as? String == "step"; let delay = delay; lock.unlock()
+        if delay > 0 { usleep(delay) }
+        if reject { return nil }
+        return ["accepted": true, "id": packet["id"]!, "seq": packet["seq"]!]
+    }
+    func snapshot() -> [[String: Any]] { lock.lock(); defer { lock.unlock() }; return packets.map(\.1) }
+    func phases() -> [String] { snapshot().compactMap { $0["phase"] as? String } }
+    func countDiscoveries() -> Int { lock.lock(); defer { lock.unlock() }; return discoveries }
+}
+
+@MainActor
+final class VSCodeBackgroundHoldControllerTests: XCTestCase {
+    private func waitFor(_ condition: () -> Bool) async {
+        let deadline = Date().addingTimeInterval(2)
+        while !condition(), Date() < deadline { try? await Task.sleep(nanoseconds: 5_000_000) }
+        XCTAssertTrue(condition())
+    }
+
+    func testHoldKeepsOriginalWindowAndSelectionUntilPhysicalRelease() async {
+        for source in [MouseSource.corsair, .razer] {
+            let wire = HoldWire()
+            var focused = true
+            let client = VSCodeBackgroundHoldController(allowed: { true }, canBegin: { focused }, discover: { wire.discover() }, exchange: { wire.send($0, $1) })
+            client.handle(.init(source: source, direction: .next, phase: .begin))
+            await waitFor { wire.phases().contains("begin") }
+            focused = false
+            client.handle(.init(source: source, direction: .next, phase: .ready))
+            XCTAssertTrue(client.step("previous", mode: "changes", source: source))
+            XCTAssertTrue(client.mode(false, source: source))
+            XCTAssertTrue(client.step("next", mode: "files", source: source))
+            await waitFor { wire.phases().filter { $0 == "step" }.count == 2 }
+            XCTAssertTrue(client.owns(source))
+            XCTAssertFalse(wire.phases().contains("finish"))
+            XCTAssertFalse(wire.phases().contains("boundary"))
+            await waitFor { wire.phases().contains("heartbeat") }
+            client.handle(.init(source: source, direction: .next, phase: .finish))
+            client.handle(.init(source: source, direction: .next, phase: .ownerRelease))
+            await waitFor { wire.phases().contains("finish") }
+            XCTAssertFalse(client.owns(source))
+            XCTAssertEqual(wire.countDiscoveries(), 1, "Focus changes must never rediscover another Code window")
+            let packets = wire.snapshot()
+            XCTAssertEqual(Set(packets.compactMap { $0["id"] as? String }).count, 1)
+            XCTAssertEqual(packets.compactMap { $0["seq"] as? Int }, Array(1...packets.count))
+            XCTAssertEqual(packets.filter { $0["phase"] as? String == "step" }.compactMap { $0["mode"] as? String }, ["changes", "files"])
+            client.handle(.init(source: source, direction: .next, phase: .begin))
+            XCTAssertFalse(client.owns(source), "A fresh background hold must be rejected")
+            client.abandonAll()
+        }
+    }
+
+    func testShortReleaseAndAdjacentUndoKeepTheirTransactionBoundary() async {
+        for cancel in [false, true] {
+            let wire = HoldWire()
+            let client = VSCodeBackgroundHoldController(allowed: { true }, canBegin: { true }, discover: { wire.discover() }, exchange: { wire.send($0, $1) })
+            client.handle(.init(source: .corsair, direction: .previous, phase: .begin))
+            client.handle(.init(source: .corsair, direction: .previous, phase: .shortRelease))
+            if cancel { client.handle(.init(source: .corsair, direction: .previous, phase: .cancel)) }
+            client.handle(.init(source: .corsair, direction: .previous, phase: .ownerRelease))
+            await waitFor { wire.phases().last == (cancel ? "cancel" : "boundary") }
+            XCTAssertEqual(wire.phases(), ["begin", "short-release", cancel ? "cancel" : "boundary"])
+            XCTAssertFalse(wire.phases().contains("finish"))
+            client.abandonAll()
+        }
+    }
+
+    func testConsecutiveHoldsNeverLoseThePreviousFinish() async {
+        let wire = HoldWire(); wire.delay = 15_000
+        let client = VSCodeBackgroundHoldController(allowed: { true }, canBegin: { true }, discover: { wire.discover() }, exchange: { wire.send($0, $1) })
+        for _ in 0..<2 {
+            client.handle(.init(source: .razer, direction: .next, phase: .begin))
+            client.handle(.init(source: .razer, direction: .next, phase: .ready))
+            client.handle(.init(source: .razer, direction: .next, phase: .finish))
+            client.handle(.init(source: .razer, direction: .next, phase: .ownerRelease))
+        }
+        await waitFor { wire.phases().filter { $0 == "finish" }.count == 2 }
+        XCTAssertEqual(wire.phases(), ["begin", "ready", "finish", "begin", "ready", "finish"])
+        XCTAssertEqual(Set(wire.snapshot().compactMap { $0["id"] as? String }).count, 2)
+        client.abandonAll()
+    }
+
+    func testConnectionFailureCannotRetargetOrFinish() async {
+        let wire = HoldWire(); wire.rejectStep = true
+        var failures = 0
+        let client = VSCodeBackgroundHoldController(allowed: { true }, canBegin: { true }, discover: { wire.discover() }, exchange: { wire.send($0, $1) })
+        client.onFailure = { _ in failures += 1 }
+        client.handle(.init(source: .corsair, direction: .next, phase: .begin))
+        client.step("next", mode: "files", source: .corsair)
+        await waitFor { failures == 1 }
+        client.handle(.init(source: .corsair, direction: .next, phase: .finish))
+        client.ownerReleased(.corsair)
+        XCTAssertFalse(wire.phases().contains("finish"))
+        XCTAssertEqual(wire.countDiscoveries(), 1)
+        XCTAssertFalse(client.owns(.corsair))
+        client.abandonAll()
+    }
+
+    func testLockDiscardsQueuedFinishWithoutStageOrUndo() async {
+        let wire = HoldWire(); wire.delay = 35_000
+        var allowed = true
+        let client = VSCodeBackgroundHoldController(allowed: { allowed }, canBegin: { true }, discover: { wire.discover() }, exchange: { wire.send($0, $1) })
+        client.handle(.init(source: .corsair, direction: .next, phase: .begin))
+        await waitFor { wire.phases().contains("begin") }
+        client.step("next", mode: "files", source: .corsair)
+        client.handle(.init(source: .corsair, direction: .next, phase: .finish))
+        allowed = false; client.abandonAll()
+        await waitFor { wire.phases().contains("abandon") }
+        XCTAssertFalse(wire.phases().contains("finish"))
+        XCTAssertFalse(wire.phases().contains("cancel"))
+        XCTAssertFalse(client.owns(.corsair))
+    }
+
+    func testWireCommandRejectsForeignNamespaceAndWand() throws {
+        let value = VSCodeStageHoldCommand(source: .razer, direction: .previous, phase: .ownerRelease)
+        XCTAssertEqual(try VSCodeStageHoldCommand.decode(JSONEncoder().encode(value)), value)
+        XCTAssertThrowsError(try VSCodeStageHoldCommand.decode(Data(#"{"command":"other","source":"razer","direction":"previous","phase":"finish"}"#.utf8)))
+        XCTAssertThrowsError(try VSCodeStageHoldCommand.decode(JSONEncoder().encode(VSCodeStageHoldCommand(source: .wand, direction: .next, phase: .begin))))
+    }
+
+    func testReplacingCurrentHoldPreservesEarlierReleasedFinish() async {
+        let wire = HoldWire(); wire.delay = 15_000
+        let client = VSCodeBackgroundHoldController(allowed: { true }, canBegin: { true }, discover: { wire.discover() }, exchange: { wire.send($0, $1) })
+        client.handle(.init(source: .corsair, direction: .next, phase: .begin))
+        client.handle(.init(source: .corsair, direction: .next, phase: .ready))
+        client.handle(.init(source: .corsair, direction: .next, phase: .finish))
+        client.ownerReleased(.corsair)
+        client.handle(.init(source: .corsair, direction: .previous, phase: .begin))
+        client.abandon(.corsair)
+        await waitFor { wire.phases().contains("finish") }
+        XCTAssertEqual(wire.phases(), ["begin", "ready", "finish"])
+        XCTAssertFalse(client.owns(.corsair))
+        client.abandonAll()
+    }
+
+    func testNativeQueueExpiresOldWheelStepsWithoutCreatingSequenceGaps() async {
+        let wire = HoldWire(); wire.delay = 70_000
+        let client = VSCodeBackgroundHoldController(allowed: { true }, canBegin: { true }, discover: { wire.discover() }, exchange: { wire.send($0, $1) })
+        client.handle(.init(source: .razer, direction: .next, phase: .begin))
+        await waitFor { wire.phases().contains("begin") }
+        for _ in 0..<10 { client.step("next", mode: "files", source: .razer) }
+        client.handle(.init(source: .razer, direction: .next, phase: .finish))
+        client.ownerReleased(.razer)
+        await waitFor { wire.phases().contains("finish") }
+        XCTAssertLessThan(wire.phases().filter { $0 == "step" }.count, 10)
+        let packets = wire.snapshot()
+        XCTAssertEqual(packets.compactMap { $0["seq"] as? Int }, Array(1...packets.count))
+        client.abandonAll()
+    }
+}
