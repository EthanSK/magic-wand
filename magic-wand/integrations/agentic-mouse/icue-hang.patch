--- a/Sources/ScimitarKit/Lighting/ICUEVendorCallExecutor.swift
+++ b/Sources/ScimitarKit/Lighting/ICUEVendorCallExecutor.swift
@@ -0,0 +1,49 @@
+import Foundation
+
+/// The vendor can wait forever for an iCUE reply. Keep that wait off the input
+/// thread, admit at most one call, and fail promptly while that call is stuck.
+/// A timed-out operation owns its buffers until it actually returns.
+final class ICUEVendorCallExecutor: @unchecked Sendable {
+    private let queue = DispatchQueue(label: "com.ethan.agentic-mouse.icue-calls")
+    private let lock = NSLock()
+    private var busy = false
+    private let timeout: TimeInterval
+
+    init(timeout: TimeInterval = 0.2) { self.timeout = timeout }
+
+    var isBusy: Bool {
+        lock.lock(); defer { lock.unlock() }
+        return busy
+    }
+
+    private final class Work<Value>: @unchecked Sendable {
+        let operation: () -> Value
+        let finished = DispatchSemaphore(value: 0)
+        private let lock = NSLock()
+        private var value: Value?
+        init(_ operation: @escaping () -> Value) { self.operation = operation }
+        func run() {
+            let result = operation()
+            lock.lock(); value = result; lock.unlock()
+        }
+        func result(or fallback: Value) -> Value {
+            lock.lock(); defer { lock.unlock() }
+            return value ?? fallback
+        }
+    }
+
+    func perform<Value>(fallback: Value, _ operation: @escaping () -> Value) -> Value {
+        lock.lock()
+        guard !busy else { lock.unlock(); return fallback }
+        busy = true
+        lock.unlock()
+        let work = Work(operation)
+        queue.async { [self, work] in
+            work.run()
+            lock.lock(); busy = false; lock.unlock()
+            work.finished.signal()
+        }
+        guard work.finished.wait(timeout: .now() + timeout) == .success else { return fallback }
+        return work.result(or: fallback)
+    }
+}
--- a/Tests/ScimitarKitTests/ICUEVendorCallExecutorTests.swift
+++ b/Tests/ScimitarKitTests/ICUEVendorCallExecutorTests.swift
@@ -0,0 +1,39 @@
+import XCTest
+@testable import ScimitarKit
+
+final class ICUEVendorCallExecutorTests: XCTestCase {
+    func testVendorWorkRunsOffTheMainThreadAndReturnsItsValue() {
+        let executor = ICUEVendorCallExecutor(timeout: 0.1)
+        XCTAssertEqual(executor.perform(fallback: false) { !Thread.isMainThread }, true)
+        XCTAssertEqual(executor.perform(fallback: 0) { 42 }, 42)
+    }
+
+    func testHungRequestTimesOutRejectsBacklogAndRecoversOnlyAfterCompletion() {
+        let executor = ICUEVendorCallExecutor(timeout: 0.03)
+        let release = DispatchSemaphore(value: 0)
+        let entered = DispatchSemaphore(value: 0)
+        let finished = DispatchSemaphore(value: 0)
+        let start = Date()
+        let result = executor.perform(fallback: -1) {
+            entered.signal()
+            release.wait()
+            finished.signal()
+            return 99
+        }
+        XCTAssertEqual(result, -1)
+        XCTAssertLessThan(Date().timeIntervalSince(start), 0.3)
+        XCTAssertEqual(entered.wait(timeout: .now() + 0.2), .success)
+        for _ in 0..<100 {
+            XCTAssertEqual(executor.perform(fallback: -2) { XCTFail("must not queue work behind the hung SDK"); return 0 }, -2)
+        }
+        release.signal()
+        XCTAssertEqual(finished.wait(timeout: .now() + 0.5), .success)
+        var recovered = -1
+        for _ in 0..<100 where recovered == -1 {
+            recovered = executor.perform(fallback: -1) { 7 }
+            if recovered == -1 { Thread.sleep(forTimeInterval: 0.001) }
+        }
+        XCTAssertEqual(recovered, 7)
+        XCTAssertEqual(result, -1, "late SDK completion never changes the returned fallback")
+    }
+}
--- a/LEARNINGS.md
+++ b/LEARNINGS.md
@@ -3218,3 +3218,10 @@
 ## 2026-10-26 — Shorter held-centre dwell
 
 Ethan shortened switchAppDwell from750ms to500ms of continuous home-centre residence AFTER receiver hold qualification. This changes only the dwell parameter: pointer timing, freshness500ms, watchdog250ms, HIGH baseline and release lifecycle stay unchanged. Preserve boundary coverage just below500ms and just after it, plus leaving/returning and pre-threshold release. The earlier750ms note is historical, not the current setting.
+
+
+## 2026-10-27 — A stalled iCUE request must not freeze mouse input
+
+A live sample found the main thread permanently waiting inside CorsairGetDevices, called by the two-second recovery probe. Both mice stopped because the main thread also owns input dispatch and the unlocked-session heartbeat. Restarting only the hung Agentic Mouse process restored a responsive event loop.
+
+Run vendor IPC through the single bounded ICUEVendorCallExecutor. Each call owns its C buffers on the worker, waits at most200ms at the synchronous boundary, and admits no backlog while a prior operation remains stuck. Later completion must not overwrite the caller's fallback or dereference expired buffers. Keep Swift session state on its existing main queue; retire and invalidate callback contexts when connection/subscription fails or times out. All disconnect, device/property reads, lighting and key-control requests use the same executor. Library loading itself only resolves the C entry points.
