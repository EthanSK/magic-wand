+        clock.advance(by: 0.4)
+        tick.fire()
+        XCTAssertEqual(buttonPhases, ["press"])
+    }
+
+    func testLeavingTheCentreResetsTheDwellAndReturningStartsAgain() {
+        let id = qualifiedHoldFromClosed()
+        clock.advance(by: 0.5)
+        aim(id, at: .wandPlayPause, sequence: 2)
+        clock.advance(by: 0.5)
+        control.handle(.init(.motion, id: id, sequence: 3, x: 0, y: 0))
+        XCTAssertEqual(control.focusedCell, .switchApp)
+        XCTAssertTrue(buttonPhases.isEmpty, "time away from the centre never counts")
+        clock.advance(by: 0.5)
+        control.handle(.init(.motion, id: id, sequence: 4))
+        XCTAssertTrue(buttonPhases.isEmpty)
+        clock.advance(by: 0.3)
+        control.handle(.init(.motion, id: id, sequence: 5))
+        XCTAssertEqual(buttonPhases, ["press"])
+    }
