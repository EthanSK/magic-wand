+    /// Turns a qualified hold resting on home Switch App into its choose
+    /// adjustment once the dwell has passed. The same native press as the
+    /// re-hold path holds Command; the hold keeps its id, sequence and last
+    /// cumulative angle, so no earlier motion is replayed, and a fresh metric
+    /// makes the first HIGH sample only a baseline. Release finishes it once.
+    private func armHeldSwitchAppAfterDwell() {
+        guard isOpen, allowed(), target.isWandHome, var current=hold,
+              current.qualified, !current.passiveNavigation, !current.adjusting,
+              current.navigation?.focusedCell == .switchApp,
+              target.pageGeneration == current.pageGeneration,
+              clock.now-current.received <= Self.switchAppDwellFreshness,
+              let since=current.centreDwellSince, clock.now-since >= Self.switchAppDwell else { return }
+        current.centreDwellSince=nil
+        hold=current
+        target.handle(.init(action:.select,source:.wand,physicalCell:.switchApp,phase:.press),inputTime:clock.now)
+        // A press that changed or ended the page must not leave an adjusting hold behind.
+        guard target.isActive, target.isWandHome, target.pageGeneration == current.pageGeneration else { return }
+        armed=nil
+        let next=Hold(id:current.id,sequence:current.sequence,last:current.last,received:current.received,
+                      navigation:nil,qualified:true,cell:.switchApp,pageGeneration:current.pageGeneration,
+                      adjusting:true)
+        hold=next
+        selected = .switchApp
+        showAdjustment(next)
+    }
