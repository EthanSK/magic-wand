+    // MARK: Held centre enters Switch App choose mode
+
+    /// Middle down from closed, then the receiver's ordinary hold threshold.
+    private func qualifiedHoldFromClosed() -> String {
+        let id = holdFromClosed()
+        clock.advance(by: 0.2)
+        control.handle(.init(.qualify, id: id, sequence: 1))
+        return id
+    }
+
+    func testHoldingStillOnTheCentreEntersChooseModeWithoutReleasing() {
+        let id = qualifiedHoldFromClosed()
+        XCTAssertTrue(buttonPhases.isEmpty, "qualification alone holds no key")
+        clock.advance(by: 0.5)
+        control.handle(.init(.motion, id: id, sequence: 2))
+        tick.fire()
+        XCTAssertTrue(buttonPhases.isEmpty, "not too fast")
+        XCTAssertNil(target.pointerFocus?.adjustment)
+        clock.advance(by: 0.3)
+        control.handle(.init(.motion, id: id, sequence: 3))
+        XCTAssertEqual(buttonPhases, ["press"], "Command goes down once, in the same hold")
+        XCTAssertNotNil(target.pointerFocus?.adjustment, "the ratchet ring shows choose mode")
+        XCTAssertTrue(switchSteps.isEmpty, "earlier motion is never replayed")
+        control.handle(.init(.motion, id: id, sequence: 4, x: 7))
+        XCTAssertEqual(switchSteps, [.down])
+        control.handle(.init(.park, id: id, sequence: 5))
+        control.handle(.init(.choose, id: nextID("choose")))
+        XCTAssertEqual(buttonPhases, ["press", "release"], "release ends the Command lifecycle once")
+        XCTAssertFalse(control.isOpen)
+        XCTAssertNil(control.armedCell, "the trailing choose never re-arms")
+        XCTAssertEqual(switchSteps.count, 1)
+        XCTAssertTrue(homeActions.isEmpty)
+    }
+
+    func testAMotionlessHeartbeatReachesTheDwellOnTheWatchdogTick() {
+        let id = qualifiedHoldFromClosed()
