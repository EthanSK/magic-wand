  "steps": [
    {
      "id": "board",
      "title": "Lower the OP1 board",
      "caption": "Plug the lead into the board, feed the lead through the holder and lower the board straight into its pocket.",
      "moves": [
        {
          "group": "op1_board",
          "start_offset": [
            0,
            0,
            16
          ],
          "path": "straight"
        }
      ]
    },
    {
      "id": "switch",
      "title": "Plug in the switch",
      "caption": "Push the switch straight down into the three sockets. Either way round fits.",
      "moves": [
        {
          "group": "switch",
          "start_offset": [
            0,
            0,
            10
          ],
          "path": "straight"
        }
      ]
    },
    {
      "id": "posts",
      "title": "Fit the post bar",
      "caption": "Away from the holder, push the post bar up through the two holes in the paddle.",
      "moves": [
        {
          "actor": "post_bar",
          "start_offset": [
            0,
            0,
            -8
          ],
          "path": "straight",
          "relative_to": "paddle"
        }
      ]
    },
    {
      "id": "touch",
      "title": "Fit the touch board",
      "caption": "Lower the touch board over the two posts and slide a clip onto each post neck.",
      "moves": [
        {
          "actors": [
            "sensor",
            "electrode",
            "connector",
            "gravity_pins"
          ],
          "start_offset": [
            0,
            0,
            12
          ],
          "path": "straight",
          "relative_to": "paddle"
        },
        {
          "actors": [
            "clip_left",
            "clip_right"
          ],
          "start_offset": [
            0,
            -5,
            0
          ],
          "path": "straight",
          "relative_to": "paddle",
          "after_previous": true
        }
      ]
    },
    {
      "id": "paddle",
      "title": "Lower the paddle",
      "caption": "Lower the paddle straight down. Its sleeve goes over the switch and the axle bar drops into the two V seats.",
      "moves": [
        {
          "rides": "paddle",
          "start_offset": [
            0,
            0,
            14
          ],
          "path": "straight"
        }
      ]
    },
    {
      "id": "cap",
      "title": "Push in the hinge cap",
      "caption": "Push the cap forward along the top of the yoke until it clicks over the ridge and sits flush with the rear face.",
      "moves": [
        {
          "actor": "hinge_cap",
          "start_offset": [
            0,
            9,
            0
          ],
          "path": "straight"
        }
      ]
    },
    {
      "id": "lid",
      "title": "Slide in the lid",
      "caption": "With the paddle resting on the switch, slide the lid in from the front along the board until its latch clicks.",
      "moves": [
        {
          "actor": "lid",
          "start_offset": [
            -11.907051,
            -31.846854,
            -0.0
          ],
          "path": "straight"
        }
      ]
    },
    {
      "id": "press",
      "title": "Press the pad",
      "caption": "Press the centre and both lower corners. Each press should click once and spring back.",
      "moves": [
        {
          "rides": "paddle",
          "hinge_angles_deg": [
            0.0,
            1.4319,
            0.0
          ]
        }
      ]
    }
  ],
