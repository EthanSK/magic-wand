{
  "schemaVersion": 1,
  "name": "Magic Wand",
  "tagline": "Mouse, HUD, scrolling and speech to text from three buttons on a wand.",
  "summary": "Turning the wand moves my Mac’s pointer or the Agentic Mouse HUD outline. A Puck.js at the tip reads the rotation and sends it over Bluetooth.",
  "updated": "2026-10-16",
  "site": "https://ethansk.github.io/magic-wand/",
  "repository": "https://github.com/EthanSK/magic-wand",
  "versions": {
    "receiver": "1.2.17",
    "receiverBuild": "22",
    "deviceRuntime": "wand-e1ce30d7c407",
    "bridgeRevision": "c68fa9b403e6a5bede176ccd4e53d0db875e593980d25944a2f162d655af0757"
  },
  "status": [
    "Earlier controls were tested on the wand; the latest gestures and tuning still need a physical check.",
    "Held positioning clicks on release and resumes prior high sensitivity after 300 ms. Ethan confirmed the still-hand tolerance feels good.",
    "End-to-end latency, accuracy and battery life haven’t been measured."
  ],
  "hardware": {
    "board": "Puck.js v2.1",
    "boardUrl": "https://www.espruino.com/Puck.js",
    "parts": [
      [
        "Tip",
        "Puck.js v2.1: gyro, Bluetooth and an RGB light"
      ],
      [
        "Shaft",
        "Carbon-fibre tube, roughly 50 cm"
      ],
      [
        "Grip",
        "Three separate wired momentary buttons"
      ]
    ],
    "wiring": "Each button connects its pin to GND. The Puck’s internal pull-ups make a press read low."
  },
  "buttons": [
    {
      "id": "top",
      "name": "Top",
      "pin": "D30",
      "key": "T",
      "role": "Speech to text",
      "light": "recording",
      "gestures": [
        [
          "Tap",
          "Start Agent Flow dictation"
        ],
        [
          "Tap again",
          "Stop and paste"
        ]
      ]
    },
    {
      "id": "middle",
      "name": "Middle",
      "pin": "D2",
      "key": "M",
      "role": "Agentic Mouse HUD",
      "light": "hud",
      "gestures": [
        [
          "Tap",
          "Open the HUD on Switch App, then turn the wand to move the outline"
        ],
        [
          "Tap again",
          "Use the outlined card"
        ],
        [
          "Hold",
          "Hold the card; on some wheel cards, tilt to turn the wheel"
        ],
        [
          "Double tap",
          "Close the HUD"
        ]
      ],
      "notes": [
        "The outline stops at the edges instead of wrapping.",
        "Bottom goes back to the pointer."
      ]
    },
    {
      "id": "bottom",
      "name": "Bottom",
      "pin": "D1",
      "key": "B",
      "role": "Mouse",
      "light": "mouse",
      "gestures": [
        [
          "Tap",
          "The pointer follows the wand, without clicking"
        ],
        [
          "Hold, turn, release",
          "Click once where you stop"
        ],
        [
          "Tap while following",
          "Click"
        ],
        [
          "Hold while following",
          "Move at low sensitivity; release clicks, pauses 300 ms, then resumes high sensitivity"
        ],
        [
          "Tap, then hold",
          "Drag; release drops, pauses 300 ms, then resumes prior high sensitivity"
        ],
        [
          "Double tap while following",
          "Stop following"
        ]
      ],
      "notes": [
        "The pointer stays still while a click is decided.",
        "Middle switches to the HUD.",
        "High sensitivity is released-button follow. Holding Bottom is low sensitivity, at one-third speed."
      ]
    }
  ],
  "chords": [
    {
      "id": "scroll",
      "name": "Bottom + Middle",
      "buttons": [
        "bottom",
        "middle"
      ],
      "role": "Scroll",
      "light": "scroll",
      "gestures": [
        [
          "Hold both and turn",
          "Scroll sideways and up or down at once, including diagonals"
        ],
        [
          "Release either",
          "Stop scrolling; nothing clicks"
        ]
      ]
    }
  ],
