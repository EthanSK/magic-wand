diff --git a/Sources/ScimitarUI/WandReviewIndicator.swift b/Sources/ScimitarUI/WandReviewIndicator.swift
new file mode 100644
index 0000000..b93bdeb
--- /dev/null
+++ b/Sources/ScimitarUI/WandReviewIndicator.swift
@@ -0,0 +1,64 @@
+import AppKit
+import SwiftUI
+
+/// A non-activating reminder of the wand's selected VS Code review mode.
+/// The controller owns its lifetime; hiding the main HUD does not clear it.
+public final class WandReviewIndicator {
+    private var panel:NSPanel?
+    private var current:String?
+    public init() {}
+    public func update(mode:String?) {
+        guard let mode, ["changes","files"].contains(mode), let screen=NSScreen.main else {
+            current=nil;panel?.orderOut(nil);panel=nil;return
+        }
+        let frame=indicatorFrame(on:screen)
+        if current == mode,let panel {panel.setFrameOrigin(frame.origin);return}
+        current=mode
+        panel?.orderOut(nil);panel=nil
+        let p=NSPanel(contentRect:frame,styleMask:[.borderless,.nonactivatingPanel],backing:.buffered,defer:false)
+        p.isOpaque=false;p.backgroundColor = .clear;p.hasShadow=true;p.level = NSWindow.Level(rawValue:NSWindow.Level.floating.rawValue+2)
+        p.hidesOnDeactivate=false;p.ignoresMouseEvents=true;p.collectionBehavior=[.canJoinAllSpaces,.fullScreenAuxiliary]
+        p.contentView=NSHostingView(rootView:WandReviewIndicatorView(mode:mode))
+        panel=p;p.orderFrontRegardless()
+    }
+    /// Use the recorder's actual on-screen panel, excluding Agent Flow's Dashboard.
+    /// Window-server coordinates have a top-left origin; AppKit uses bottom-left.
+    private func indicatorFrame(on screen:NSScreen)->NSRect {
+        let pids=Set(NSWorkspace.shared.runningApplications.filter {
+            $0.executableURL?.lastPathComponent == "AgentFlow"
+        }.map { $0.processIdentifier })
+        let windows=CGWindowListCopyWindowInfo([.optionOnScreenOnly,.excludeDesktopElements],kCGNullWindowID) as? [[String:Any]] ?? []
+        let top=NSScreen.screens.first?.frame.maxY ?? screen.frame.maxY
+        let recorder=windows.compactMap { info -> CGRect? in
+            guard let owner=info[kCGWindowOwnerPID as String] as? Int32,pids.contains(owner),
+                  let layer=info[kCGWindowLayer as String] as? Int,layer>0,
+                  let data=info[kCGWindowBounds as String] as? NSDictionary,
+                  let cg=CGRect(dictionaryRepresentation:data),cg.width>=160,cg.width<1400,
+                  cg.height>=35,cg.height<700 else{return nil}
+            let r=CGRect(x:cg.minX,y:top-cg.maxY,width:cg.width,height:cg.height)
+            guard r.intersects(screen.frame),abs(r.midX-screen.visibleFrame.midX)<300,
+                  r.minY<screen.visibleFrame.minY+360 else{return nil}
+            return r
+        }.max { $0.maxY < $1.maxY }
+        let bottom=recorder.map {$0.maxY+12} ?? (screen.visibleFrame.minY+168)
+        return NSRect(x:screen.visibleFrame.midX-105,
+            y:min(screen.visibleFrame.maxY-64,bottom),width:210,height:52)
+    }
+
+}
+struct WandReviewIndicatorView:View {
+    let mode:String
+    var body:some View {
+        VStack(spacing:3) {
+            Label(mode == "changes" ? "Review changes" : "Stage files",systemImage:mode == "changes" ? "eye" : "doc.on.doc")
+                .font(.system(size:12,weight:.semibold,design:.rounded))
+            // Ethan calls staging the selected working set "commit set".
+            Text("(hold to commit set)")
+                .font(.system(size:10,weight:.medium,design:.rounded))
+        }
+            .foregroundStyle(Color.black)
+            .padding(.horizontal,14).frame(width:210,height:52)
+            .background(mode == "changes" ? Color.green : Color(red:0.78,green:0.6,blue:1),in:Capsule())
+            .overlay(Capsule().strokeBorder(.white.opacity(0.28),lineWidth:1))
+    }
+}
