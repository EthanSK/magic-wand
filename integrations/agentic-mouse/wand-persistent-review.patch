diff --git a/Sources/ScimitarUI/WandReviewIndicator.swift b/Sources/ScimitarUI/WandReviewIndicator.swift
new file mode 100644
index 0000000..4ecff12
--- /dev/null
+++ b/Sources/ScimitarUI/WandReviewIndicator.swift
@@ -0,0 +1,33 @@
+import AppKit
+import SwiftUI
+
+/// A non-activating reminder of the wand's selected VS Code review mode.
+/// The controller owns its lifetime; hiding the main HUD does not clear it.
+public final class WandReviewIndicator {
+    private var panel:NSPanel?
+    private var current:String?
+    public init() {}
+    public func update(mode:String?) {
+        guard mode != current else { return }
+        current=mode
+        panel?.orderOut(nil);panel=nil
+        guard let mode, ["changes","files"].contains(mode), let screen=NSScreen.main else{return}
+        let frame=NSRect(x:screen.visibleFrame.midX-90,y:screen.visibleFrame.minY+18,width:180,height:36)
+        let p=NSPanel(contentRect:frame,styleMask:[.borderless,.nonactivatingPanel],backing:.buffered,defer:false)
+        p.isOpaque=false;p.backgroundColor = .clear;p.hasShadow=true;p.level = .floating
+        p.hidesOnDeactivate=false;p.ignoresMouseEvents=true;p.collectionBehavior=[.canJoinAllSpaces,.fullScreenAuxiliary]
+        p.contentView=NSHostingView(rootView:WandReviewIndicatorView(mode:mode))
+        panel=p;p.orderFrontRegardless()
+    }
+}
+struct WandReviewIndicatorView:View {
+    let mode:String
+    var body:some View {
+        Label(mode == "changes" ? "Review changes" : "Stage files",systemImage:mode == "changes" ? "eye" : "doc.on.doc")
+            .font(.system(size:12,weight:.semibold,design:.rounded))
+            .foregroundStyle(mode == "changes" ? Color.green : Color.purple)
+            .padding(.horizontal,14).frame(width:180,height:36)
+            .background(.ultraThinMaterial,in:Capsule())
+            .overlay(Capsule().strokeBorder(.white.opacity(0.28),lineWidth:1))
+    }
+}
diff --git a/Tests/ScimitarKitTests/WandPersistentControlTests.swift b/Tests/ScimitarKitTests/WandPersistentControlTests.swift
